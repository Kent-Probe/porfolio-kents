---
import { Eye, SearchIcon, XIcon } from "@lucide/astro";
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";

// Obtener parámetros de búsqueda del URL
const proyects = await getCollection("proyects");
---

<Layout>
  <section class="relative bg-bg-primary w-full min-h-screen">
    <a
      href="/#proyects"
      class="group fixed top-5 end-5 md:top-0 md:start-0 w-16 h-16 md:h-full bg-bg-secondary z-10 flex md:items-start items-center justify-center md:pt-6"
    >
      <XIcon class="text-accent cursor-pointer group-hover:text-accent/60" />
    </a>
    <div class="md:max-w-[calc(100%_-_theme(space.64))] max-w-[calc(100%_-_theme(space.32))] w-full m-auto py-20">
      <div id="proyects-header" class="w-full flex flex-col justify-between gap-4 text-white mb-[40px]">
        <h2 class="flex-1 text-4xl font-bold">Proyectos</h2>
        <div class="flex-1 flex gap-4 relative" id="proyects-search">
          <div class="absolute inset-y-0 start-0 flex items-center ps-3 pointer-events-none z-10">
            <SearchIcon class="w-4 h-4" />
          </div>
          <input
            transition:name="search"
            type="text"
            name="search"
            class="w-full p-2 ps-10 rounded-md bg-gray-800 text-white border border-gray-700 focus:outline-none focus:ring-2 focus:ring-red-500"
            placeholder="Buscar proyectos por tecnología o palabra clave"
          />
        </div>
      </div>

      <div id="proyects-content" class="grid md:grid-cols-3 grid-cols-1 gap-4 text-white">
        {
          proyects.length === 0 ? (
            <div class="col-span-full text-center text-gray-400 py-8">
              <p>No se encontraron proyectos que coincidan con tu búsqueda.</p>
            </div>
          ) : (
            proyects.map((proyect) => (
              <div class="relative w-full h-[500px] group hover:border-accent border-transparent border-1 transition-all duration-300 ease-in-out rounded-lg cursor-pointer overflow-hidden">
                <div class="relative w-full h-3/5 bg-accent-50">
                  <div class="absolute inset-0 opacity-0 group-hover:opacity-100  bg-gradient--img-card transition-all duration-300 ease-in-out transition-discrete" />
                  <img
                    loading="lazy"
                    src={proyect.data.img}
                    alt={proyect.data.title}
                    class="w-full h-full object-cover"
                  />
                </div>
                <div class="h-2/5 p-4 pt-9 bg-primary group-hover:overflow-y-auto gutter-stable">
                  <h3 class="text-2xl font-bold mb-2 h-14 flex items-end">
                    <span class="line-clamp-2 w-full">{proyect.data.title}</span>
                  </h3>
                  <div class="description-container md:w-[480px] w-60">
                    <p class="mb-4 description-with-fade">{proyect.data.description}</p>
                  </div>
                </div>
                <div class="absolute top-[calc(60%-56px/2)] left-[calc(50%-56px/2)] text-sm font-medium flex items-center text-accent p-4 z-10 bg-bg-secondary rounded-full w-fit group-hover:animate-rotate-shekel">
                  <Eye class="m-auto" />
                </div>
              </div>
            ))
          )
        }
      </div>
    </div>
  </section>
</Layout>

<style>
  .w-sfull {
    width: -webkit-fill-available;
  }

  .gutter-stable {
    scrollbar-gutter: stable;
  }

  .bg-gradient--img-card {
    background: linear-gradient(
      to top,
      var(--color-primary) 0%,
      color-mix(in oklab, var(--color-primary) 50%, transparent) 100%
    );
  }

  .description-container {
    position: relative;
    max-height: 3rem;
    overflow: hidden;
    transition: max-height 0.4s ease-in-out;
  }

  .description-with-fade {
    width: 100%;
  }

  .description-with-fade::after {
    content: "";
    position: absolute;
    bottom: -5px;
    left: 0;
    right: 0;
    height: 100%;
    background: linear-gradient(transparent, var(--color-primary));
    opacity: 1;
    transition: opacity 0.3s ease-in-out;
  }

  .group:hover .description-container {
    max-height: 500px;
  }

  .group:hover .description-with-fade::after {
    opacity: 0;
  }
</style>
