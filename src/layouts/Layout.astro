---
import ClientRouter from "astro/components/ClientRouter.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content="Portafolio de Kevin Hernández - Desarrollador Full Stack" />
    <meta name="author" content="Kevin Hernández (Kents)" />
    <meta
      name="keywords"
      content="Kents, kent-probe, kent-voyager, kentdar, desarrollador, portfolio, Kevin Santiago Hernández Escobar"
    />
    <meta name="generator" content={Astro.generator} />
    <title>Kevin Hernández</title>
    <ClientRouter />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  ::-webkit-scrollbar {
    width: 6px;
  }

  ::-webkit-scrollbar-track {
    background: rgba(26, 29, 35, 0.5);
  }

  ::-webkit-scrollbar-thumb {
    background: linear-gradient(45deg, #d62828, #ff4444);
    border-radius: 3px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: linear-gradient(45deg, #ff4444, #d62828);
  }

  html,
  body {
    scroll-behavior: smooth;

    overflow-x: hidden;

    margin: 0;
    width: 100%;
    height: 100%;

    font-family: "Inter", sans-serif;
    color: #fff;

    scrollbar-width: thin;
    scrollbar-color: #d62828 rgba(26, 29, 35, 0.5);
  }

  ::selection {
    background-color: #d62828;
    color: white;
    text-shadow: 0 0 5px black;
  }
</style>
