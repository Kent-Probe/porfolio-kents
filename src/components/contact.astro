---
import { Github, Linkedin, MailIcon, PhoneCall } from "@lucide/astro";
---

<div class="max-w-[1500px] m-auto flex flex-col md:flex-row gap-10">
  <div
    class="flex flex-col gap-5 md:w-2/5 justify-center items-start bg-bg-primary/50 p-10 rounded-2xl shadow-neon backdrop-blur-md"
  >
    <div>
      <h2 class="md:text-5xl text-2xl font-bold">
        ¿Tienes alguna idea? o <span class="text-accent">quieres ponerte en contacto conmigo?</span>
      </h2>
    </div>

    <div class="flex md:flex-row gap-3 flex-col w-full mt-4">
      <a
        class="flex flex-row md:gap-4 gap-2 p-2 bg-accent border rounded-md border-bg-primary flex-1"
        href="mailto:kevinshe01@gmail.com"
        target="_blank"
        rel="noopener noreferrer"
      >
        <MailIcon />
        <div class="">
          <p>Enviar un correo a:</p>
          <p>kevinshe01@gmail.com</p>
        </div>
      </a>

      <a
        class="flex flex-row md:gap-4 gap-2 p-2 bg-accent border rounded-md border-bg-primary flex-1"
        href="https://wa.me/+573227020440"
        target="_blank"
        rel="noopener noreferrer"
      >
        <PhoneCall />
        <div class="">
          <p>WhatsApp/número:</p>
          <p>+57 322 7020440</p>
        </div>
      </a>
    </div>

    <div class="mt-6 w-full">
      <p class="text-sm text-gray-300">Estaré encantado de responder cualquier pregunta o inquietud que tengas.</p>
      <p class="text-sm text-gray-300">Puedes encontrarme en la red como: Kevin, Kents, Kent_Probe, Kent_Voyager.</p>
      <p class="text-sm text-red-300">O contactarme a través de mis redes sociales:</p>
      <ul class="data-socials flex flex-row gap-4 mt-6">
        <li>
          <a href="https://www.linkedin.com/in/kevin-santiago-hernandez-escobar-7621261ba/">
            <Linkedin />
            LinkedIn
          </a>
        </li>
        <li>
          <a href="https://github.com/Kent-Probe">
            <Github />
            GitHub
          </a>
        </li>
      </ul>
    </div>
  </div>
  <div class="flex relative md:p-5 md:pr-36 md:pb-0 md:w-3/5 w-full p-0">
    <div class="bg-bg-primary absolute -left-50 md:-left-20 -bottom-20 -top-20 w-[1500px] -z-10"></div>
    <form action="" class="flex flex-col gap-5 justify-center items-start w-full">
      <div class="flex w-full flex-col">
        <label class="block uppercase tracking-wide text-accent text-xs font-bold mb-2" for="name">Nombre:</label>
        <input
          class="w-full bg-bg-secondary/50 p-2 rounded-md focus-within:outline-2 focus-within:outline-accent focus-within:shadow-glass focus-within:bg-bg-secondary"
          type="text"
          id="name"
          name="name"
          required
        />
      </div>
      <div class="flex w-full flex-col">
        <label class="block uppercase tracking-wide text-accent text-xs font-bold mb-2" for="email"
          >Correo electrónico:</label
        >
        <input
          class="w-full bg-bg-secondary/50 p-2 rounded-md focus-within:outline-2 focus-within:outline-accent focus-within:shadow-glass focus-within:bg-bg-secondary"
          type="email"
          id="email"
          name="email"
          required
        />
      </div>
      <div class="flex h-full w-full flex-col">
        <label class="block uppercase tracking-wide text-accent text-xs font-bold mb-2" for="message">Mensaje:</label>
        <textarea
          class="w-full md:h-full h-auto bg-bg-secondary/50 p-2 rounded-md resize-none focus-within:outline-2 focus-within:outline-accent focus-within:shadow-glass focus-within:bg-bg-secondary"
          id="message"
          name="message"
          rows="4"
          autocomplete="off"
          spellcheck="false"
          data-gramm="false"
          data-gramm_editor="false"
          data-enable-grammarly="false"
          required></textarea>
      </div>
      <div class="flex w-full flex-col">
        <button
          class="bg-accent text-white p-2 rounded-md hover:bg-accent/80 transition-all ease-in-out duration-300 cursor-pointer"
          type="submit">Enviar</button
        >
      </div>
    </form>
  </div>
</div>

<style>
  .data-socials {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 20px;
    width: 400px;
    & > li {
      width: 100px;
      height: 100px;

      padding: 5px 10px;
      border: 1px solid #444;
      border-radius: 8px;
      background-color: #222;
      min-width: 100px;
      text-align: center;
      background-color: #222;

      & > a {
        width: 100%;
        height: 100%;

        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 10px;

        font-size: 1rem;
      }
    }
  }
</style>
