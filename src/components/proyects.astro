---
// TODO: Add animations for project cards
// TODO: Add hover effects for project cards
// TODO: Add proyects, you can use the md files
// TODO: Create engine search for the proyects

import { SearchIcon } from "@lucide/astro";
---

<div class="max-w-[1000px] m-auto">
  <div id="proyects-header" class="flex flex-wrap items-center justify-between gap-4 text-white mb-[40px]">
    <h2 class="flex-1 text-4xl font-bold">Proyectos</h2>
    <div class="flex-1 flex gap-4 relative" id="proyects-search">
      <div class="absolute inset-y-0 start-0 flex items-center ps-3 pointer-events-none">
        <SearchIcon class="w-4 h-4" jj />
      </div>
      <input
        type="text"
        class="w-sfull p-2 ps-10 rounded-md bg-gray-800 text-white border border-gray-700 focus:outline-none focus:ring-2 focus:ring-red-500"
        placeholder="Buscar proyectos por tecnología o palabra clave"
      />
    </div>
  </div>

  <div id="proyects-content" class="grid md:grid-cols-3 grid-cols-1 gap-4 text-white">
    <div class="w-full h-[500px] bg-accent p-4 border-bg-primary">Proyecto 1</div>
    <div class="w-full h-[500px] bg-accent p-4 border-bg-primary">Proyecto 2</div>
    <div class="w-full h-[500px] bg-accent p-4 border-bg-primary">Proyecto 3</div>
  </div>
</div>

<style>
  .w-sfull {
    width: -webkit-fill-available;
  }
</style>
