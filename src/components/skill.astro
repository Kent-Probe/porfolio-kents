---
// TODO: Add animations for skill categories
// TODO: Add circle background for skill logos
// TODO: Add hover effects for skill items

import { skills } from "../content/skills/skills";
const hardSkills = ["Databases", "Languages", "Frameworks", "Tools"];
---

<div class="max-w-[1000px] m-auto">
  <div class="mb-[40px] text-center">
    <h2 class="text-6xl">Habilidades</h2>
    <p class="text-gray-400">Tecnologías y habilidades que domino</p>
  </div>
  <div class="grid md:grid-cols-2 grid-cols-1 gap-8 text-white">
    <div
      class="relative h-[200px] bg-primary/50 p-4 border-bg-primary rounded-lg flex items-center justify-center flex-col cursor-pointer hover:scale-105 transition-transform duration-300 ease-in-out group"
    >
      <h3 class="text-3xl group-hover:scale-110 transition-transform duration-300 ease-in-out">Habilidades Duras</h3>
      <div class="hidden absolute bg-bg-primary p-4 border-bg-primary/80 group-hover:block">
        {
          hardSkills.map((category) => (
            <div key={category}>
              <h4>{category}</h4>
              <ul>
                {skills.hard[category.toLowerCase()].map((skill) => (
                  <li key={skill.name}>
                    <img width="40" height="40" src={skill.logo.src} alt={skill.name} />
                    <span>{skill.name}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
    <div
      class="relative h-[200px] bg-primary/50 p-4 border-bg-primary rounded-lg flex items-center justify-center flex-col cursor-pointer hover:scale-105 transition-transform duration-300 ease-in-out group"
      group
    >
      <h3 class="text-3xl group-hover:scale-110 transition-transform duration-300 ease-in-out">Habilidades Blandas</h3>
      <div class="hidden absolute bg-bg-primary p-4 border-bg-primary/80 group-hover:block">
        <ul>
          {skills.soft.map((skill) => <li key={skill}>{skill.name}</li>)}
        </ul>
      </div>
    </div>
  </div>
</div>

<style>
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  li {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
  }

  img {
    border-radius: 8px;
  }
</style>
