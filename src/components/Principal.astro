---
import { ArrowRight } from "@lucide/astro";
import logo from "../assets/logo.svg";
---

<section class="text-red-500 flex flex-col items-center justify-center h-full space-y-10">
  <div class="flex justify-center">
    <img width="100" height="100" src={logo.src} alt="Logo" />
  </div>
  <div class="">
    <h1 class="font-extrabold text-7xl tracking-widest text-shadow-lg/30">KENTS</h1>
  </div>
  <div>
    <p class="text-lg text-shadow-lg">Soy Kevin Santiago Hernández Escobar.</p>
    <p class="text-lg text-shadow-lg">Ingeniero de sistemas y Desarrollador de software.</p>
  </div>
  <div class="bg-primary/20 backdrop-blur-md p-10 rounded-lg">
    <p class="text-lg text-shadow-lg opacity-90">Soy lo que necesitabas para solucionar tus problemas.</p>
    <div class="mt-4 flex space-x-6 justify-center">
      <a
        class="text-lg font-semibold p-5 bg-primary/50 border-2 border-solid border-primary rounded-xl hover:bg-primary transition duration-300 ease-in-out"
        href="#contact"
      >
        Contactarme
      </a>
      <a
        class="text-lg font-semibold p-5 bg-primary/50 border-2 border-solid border-primary rounded-xl hover:bg-primary transition duration-300 ease-in-out"
        href="#contact"
      >
        Descargar CV
      </a>
    </div>
  </div>
  <div>
    <a class="group flex gap-10 justify-center text-lg font-semibold" href="#proyects">
      Explorar
      <ArrowRight class="group-hover:rotate-90 transition-transform duration-300 ease-in-out" color="red" />
    </a>
  </div>
</section>
