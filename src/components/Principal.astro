---
import { ArrowRight } from "@lucide/astro";
import logo from "../assets/logo.svg";
---

<section class="text-red-500 flex flex-col items-center justify-center h-full space-y-10">
  <div class="flex justify-center">
    <img width="100" height="100" src={logo.src} alt="Logo" />
  </div>
  <div class="">
    <h1 class="font-extrabold text-7xl tracking-widest text-shadow-lg/30">KENTS</h1>
  </div>
  <div>
    <p class="text-lg text-shadow-lg">Soy Kevin Santiago Hernández Escobar.</p>
    <p class="text-lg text-shadow-lg">Ingeniero de sistemas y Desarrollador de software.</p>
  </div>
  <div class="bg-primary/20 backdrop-blur-md p-10 rounded-lg">
    <p class="text-lg text-shadow-lg opacity-60">Soy lo que necesitabas para solucionar tus problemas.</p>
    <a href="#contact">
      Contactarme
      <ArrowRight color="red" />
    </a>
  </div>
  <div>
    <a href="#projects"> Explorar </a>
  </div>
</section>
