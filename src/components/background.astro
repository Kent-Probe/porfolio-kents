<script>
  import gsap from "gsap";

  const svg = document.querySelector(".circuit-lines");
  const svgWidth = 1000;
  const svgHeight = 1000;
  const numLines = 15;
  const maxSegmentLength = 150;
  const minSegments = 3;
  const maxSegments = 6;

  // Función para crear un punto aleatorio dentro del SVG
  function getRandomPoint() {
    return {
      x: Math.random() * svgWidth,
      y: Math.random() * svgHeight,
    };
  }

  // Función para dibujar una línea de circuito con múltiples segmentos
  function drawCircuitLine() {
    const path = document.createElementNS("http://www.w3.org/2000/svg", "path");
    path.classList.add("circuit-line");
    let d = "";
    let currentPoint = getRandomPoint();
    d += `M${currentPoint.x},${currentPoint.y}`;

    const numLineSegments = Math.floor(Math.random() * (maxSegments - minSegments + 1)) + minSegments;

    for (let i = 0; i < numLineSegments; i++) {
      let nextPoint = { ...currentPoint };

      // segmento horizontal o vertical
      if (Math.random() < 0.5) {
        nextPoint.x += Math.random() * maxSegmentLength * 2 - maxSegmentLength;
        d += ` H${nextPoint.x}`;
        nextPoint.y += Math.random() * maxSegmentLength * 2 - maxSegmentLength;
        d += ` V${nextPoint.y}`;
      } else {
        nextPoint.y += Math.random() * maxSegmentLength * 2 - maxSegmentLength;
        d += ` V${nextPoint.y}`;
        nextPoint.x += Math.random() * maxSegmentLength * 2 - maxSegmentLength;
        d += ` H${nextPoint.x}`;
      }

      // Asegurarse de que los puntos no se salgan del SVG
      nextPoint.x = Math.max(0, Math.min(svgWidth, nextPoint.x));
      nextPoint.y = Math.max(0, Math.min(svgHeight, nextPoint.y));

      currentPoint = nextPoint;
    }

    path.setAttribute("d", d);
    svg.appendChild(path);

    return path;
  }

  function initCircuitAnimation() {
    const allLines = [];
    for (let i = 0; i < numLines; i++) {
      allLines.push(drawCircuitLine());
    }

    allLines.forEach((line) => {
      // Clonar la línea
      const lightTrail = line.cloneNode(true) as SVGPathElement;
      lightTrail.classList.remove("circuit-line");
      lightTrail.classList.add("light-trail");
      svg.appendChild(lightTrail);

      const length = lightTrail.getTotalLength();

      gsap.set(lightTrail, {
        strokeDasharray: length,
        strokeDashoffset: length,
      });

      gsap.to(lightTrail, {
        strokeDashoffset: -length,
        duration: gsap.utils.random(10, 15),
        ease: "none",
        repeat: -1,
        delay: gsap.utils.random(0, 5),
      });

      gsap.to(lightTrail, {
        opacity: gsap.utils.random(0.5, 0.8),
        duration: gsap.utils.random(3, 8),
        ease: "power1.inOut",
        yoyo: true,
        repeat: -1,
        delay: gsap.utils.random(0, 3),
      });
    });

    gsap.to(allLines, {
      opacity: gsap.utils.random(0.1, 0.3),
      duration: gsap.utils.random(8, 15),
      ease: "power1.inOut",
      yoyo: true,
      repeat: -1,
      stagger: 0.5,
      delay: gsap.utils.random(0, 5),
    });
  }

  initCircuitAnimation();
</script>

<div class="background-container">
  <svg class="circuit-lines" viewBox="0 0 1000 1000" preserveAspectRatio="xMidYMid slice"></svg>
</div>

<div class="content">
  <slot />
</div>

