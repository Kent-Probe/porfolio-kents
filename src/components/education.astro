---
import { getCollection } from "astro:content";

// TODO: Add filter for educations and certificates (official and non-official) styles

const education = await getCollection("education");
const certificates = education.flatMap(
  (edu) =>
    edu.data.imgs?.map((img) => ({
      url: img,
      title: edu.data.title,
      description: edu.data.description,
    })) || []
);
---

<div class="max-w-[1000px] m-auto flex flex-col gap-10">
  <div class="flex flex-col md:flex-row gap-10">
    <div class="h-[400px] bg-bg-primary flex-1 overflow-y-auto p-6 rounded-lg">
      <div class="w-full max-w-3xl mx-auto">
        <div class="-my-6">
          {
            education.map((edu) => (
              <div class="relative pl-8 sm:pl-12 py-6 group">
                <div class="font-medium text-accent-3 mb-1 sm:mb-0">{edu.data.title}</div>
                <div class="flex flex-col items-start mb-1 group-last:before:hidden before:absolute before:left-2 sm:before:left-0 before:h-full before:px-px before:bg-slate-300 sm:before:ml-[1rem] before:self-start before:-translate-x-1/2 before:translate-y-3 after:absolute after:left-2 sm:after:left-0 after:w-2 after:h-2 after:bg-accent-3 after:border-4 after:box-content after:border-slate-50 after:rounded-full sm:after:ml-[1rem] after:-translate-x-1/2 after:translate-y-1.5 ">
                  <p aria-label="time" class="text-xs font-semibold uppercase w-full text-slate-300">
                    {edu.data.initialDate} - {edu.data.endDate}
                  </p>
                  <div class="text-xl font-bold text-accent">{edu.data.institution}</div>
                </div>
                <div class="text-white/80">{edu.data.description}</div>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <div class="h-[400px] bg-bg-primary flex-1">
      <div
        class="h-full w-full flex flex-row overflow-x-auto overflow-y-hidden p-5 items-center gap-3 scrollbar-thin scrollbar-thumb-accent scrollbar-track-bg-secondary"
      >
        {
          certificates.map((i) => (
            <div class="flex-none">
              <img
                width="200"
                height="300"
                src={i.url}
                alt={`${i.title} - Certificado`}
                class="rounded-md w-[200px] h-[300px] object-cover shadow-lg hover:shadow-xl transition-shadow duration-300 overflow-hidden bg-white"
              />
            </div>
          ))
        }
      </div>
    </div>
  </div>
  <!-- <div class="w-full bg-bg-primary rounded-lg">
    <div class="radio-group">
      <input type="radio" name="plan" id="all" checked="" />
      <label for="all">Todos</label>

      <input type="radio" name="plan" id="official" />
      <label for="official">Estudios officiales</label>

      <input type="radio" name="plan" id="unofficial" />
      <label for="unofficial">Estudios no oficiales</label>

      <div class="slider-element"></div>
    </div>
  </div> -->
</div>

<style>
  .radio-group {
    display: flex;
    position: relative;
    background: var(--color-bg-primary);
    border-radius: 1rem;
    backdrop-filter: blur(12px);
    overflow: hidden;
    width: 100%;
  }

  .radio-group input {
    display: none;
  }

  .radio-group label {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 80px;
    font-size: 14px;
    padding: 0.8rem 1.6rem;
    cursor: pointer;
    font-weight: 600;
    letter-spacing: 0.3px;
    color: var(--color-text);
    position: relative;
    z-index: 2;
    transition: color 0.3s ease-in-out;
  }

  .radio-group label:hover {
    color: white;
  }

  .radio-group input:checked + label {
    color: #fff;
  }

  .slider-element {
    position: absolute;
    top: 0;
    bottom: 0;
    width: calc(100% / 3);
    border-radius: 1rem;
    z-index: 1;
    transition:
      transform 0.5s cubic-bezier(0.37, 1.95, 0.66, 0.56),
      background 0.4s ease-in-out,
      box-shadow 0.4s ease-in-out;
  }

  #all:checked ~ .slider-element {
    transform: translateX(0%);
    background: linear-gradient(135deg, var(--color-accent-50), var(--color-accent));
    box-shadow: var(--shadow-glass);
  }

  #official:checked ~ .slider-element {
    transform: translateX(100%);
    background: linear-gradient(135deg, var(--color-accent-50), var(--color-accent-2));
    box-shadow: var(--shadow-glass);
  }

  #unofficial:checked ~ .slider-element {
    transform: translateX(200%);
    background: linear-gradient(135deg, var(--color-accent-50), var(--color-accent-3));
    box-shadow: var(--shadow-glass);
  }
</style>
